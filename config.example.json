{
  "DataDir": "./honeypot-data",
  "Limits": {
    "MaxConcurrentConns": 64,
    "SessionTimeout": "5m",
    "IdleTimeout": "30s",
    "MaxSessionBytes": 1048576,
    "MaxEventsPerSession": 1024,
    "MaxSessions": 10000
  },
  "Dedup": {
    "Window": "1m",
    "IncludeFingerprint": false
  },
  "Services": [
    {
      "Name": "http-honeypot",
      "Protocol": "http",
      "Listen": "127.0.0.1:8080",
      "Banner": "nginx/1.24.0",
      "Enabled": true,
      "Behavior": {
        "DefaultResponse": "<html><body>It works!</body></html>\n",
        "Responses": {
          "GET /admin": "<html><body>admin login</body></html>\n"
        },
        "ReadTimeout": "30s",
        "WriteTimeout": "10s",
        "IdleTimeout": "30s"
      }
    },
    {
      "Name": "ssh-honeypot",
      "Protocol": "ssh",
      "Listen": "127.0.0.1:2222",
      "Banner": "SSH-2.0-OpenSSH_8.9",
      "Enabled": true
    },
    {
      "Name": "ftp-honeypot",
      "Protocol": "ftp",
      "Listen": "127.0.0.1:2121",
      "Banner": "220 ProFTPD Server (Debian)\r\n",
      "Enabled": true
    },
    {
      "Name": "tcp-honeypot",
      "Protocol": "tcp",
      "Listen": "127.0.0.1:9000",
      "Banner": "Welcome to test service\r\n",
      "Enabled": true,
      "Behavior": {
        "DefaultResponse": "OK\r\n",
        "Responses": {
          "VERSION": "VERSION 1.0\r\n"
        }
      }
    }
  ]
}
