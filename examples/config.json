{
  "data_dir": "./data",
  "limits": {
    "max_concurrent_conns": 256,
    "session_timeout": "30s",
    "read_timeout": "5s",
    "write_timeout": "5s",
    "max_session_bytes": 65536,
    "max_records": 1000000
  },
  "dedup": {
    "window": "1m",
    "keys": ["source", "signature"]
  },
  "services": [
    {
      "name": "web",
      "kind": "http",
      "listen": "127.0.0.1:18080",
      "enabled": true,
      "behavior": { "status": 200, "body": "OK\n" }
    },
    {
      "name": "shell",
      "kind": "ssh",
      "listen": "127.0.0.1:10022",
      "enabled": true,
      "banner": "SSH-2.0-OpenSSH_8.9\r\n",
      "behavior": { "response": "Protocol mismatch.\r\n" }
    },
    {
      "name": "files",
      "kind": "ftp",
      "listen": "127.0.0.1:10021",
      "enabled": true,
      "banner": "220 ProFTPD 1.3.8 Server ready\r\n"
    },
    {
      "name": "raw",
      "kind": "tcp",
      "listen": "127.0.0.1:19000",
      "enabled": true,
      "behavior": { "response": "echo:" }
    }
  ]
}
